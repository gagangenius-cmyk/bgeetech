# --- AI chatbot (optional: without a key the bot uses scripted answers) ---
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. A smaller model such as claude-haiku-5-5 is much cheaper for a public chatbot.
CHAT_MODEL=
# Set to "true" to let the bot search the web for up-to-date tech questions (extra cost).
CHAT_WEB_SEARCH=

# --- Lead delivery (all optional; leads are always appended to data/leads.jsonl on persistent hosts) ---
# Receives a JSON POST per lead (Zapier, Make, Google Apps Script, CRM webhook...)
LEAD_WEBHOOK_URL=
# Email notification through Resend
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=

# --- MySQL / MariaDB (Sequelize). Tables are created automatically on first start. ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# --- Admin panel (/admin) ---
# 32+ random characters used to sign admin session cookies: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Creates the first admin on first start when no admin exists. Change the password after signing in, then remove these.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Website builder payments (Stripe Checkout, subscription mode). Without a key, orders are saved and a payment link is sent manually. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public site origin used for Stripe redirects (defaults to https://bgeetech.com)
SITE_URL=
